# Copy to .env.production on the VPS and replace every placeholder.
MYSQL_DATABASE=rewind
DB_USERNAME=rewind
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
JWT_SECRET=replace-with-at-least-48-random-bytes
PUBLIC_BASE_URL=https://rewind.example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@example.com
TMDB_ENABLED=false
TMDB_API_KEY=
TMDB_SCHEDULER_ENABLED=false
TMDB_SCHEDULER_BATCH_SIZE=10
TMDB_SCHEDULER_INTERVAL_MS=86400000
TMDB_SCHEDULER_INITIAL_DELAY_MS=60000
HTTP_PORT=127.0.0.1:8088
