# Local Vite frontend using the same hosted Supabase services as GitHub Pages.
# Copy this file to .env.local and set the client-safe key from the GitHub
# repository variable SUPABASE_PUBLISHABLE_KEY.
# Never use a Supabase service-role or secret key in a Vite variable.
VITE_API_BASE_URL=https://cuirmicbzspomijgkkwo.supabase.co/functions/v1/rewind-api/api
VITE_SUPABASE_URL=https://cuirmicbzspomijgkkwo.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-client-safe-publishable-key
VITE_SUPABASE_AUTH_ENABLED=true
